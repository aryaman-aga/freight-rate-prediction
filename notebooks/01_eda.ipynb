{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Freight Rate Prediction - Exploratory Data Analysis\n",
    "\n",
    "This notebook explores the training and validation data to inform feature engineering and modeling decisions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "pd.set_option('display.max_columns', 100)\n",
    "pd.set_option('display.width', 200)\n",
    "\n",
    "# Load data\n",
    "train = pd.read_csv('data/train_test.csv')\n",
    "val = pd.read_csv('data/validation.csv')\n",
    "dec = pd.read_csv('data/december_chart_inputs.csv')\n",
    "\n",
    "for df in [train, val, dec]:\n",
    "    df['date'] = pd.to_datetime(df['date'])\n",
    "\n",
    "print(f\"Train: {train.shape}\")\n",
    "print(f\"Val:   {val.shape}\")\n",
    "print(f\"Dec:   {dec.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Target distribution\n",
    "print(train['posted_rate'].describe())\n",
    "\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "train['posted_rate'].hist(bins=50, ax=axes[0], edgecolor='black')\n",
    "axes[0].set_title('Posted Rate')\n",
    "np.log1p(train['posted_rate']).hist(bins=50, ax=axes[1], edgecolor='black')\n",
    "axes[1].set_title('Log(1 + Posted Rate)')\n",
    "(train['posted_rate'] / train['distance']).hist(bins=50, ax=axes[2], edgecolor='black')\n",
    "axes[2].set_title('Rate per Mile')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Time series patterns\n",
    "train['rpm'] = train['posted_rate'] / train['distance']\n",
    "\n",
    "daily = train.groupby('date').agg(\n",
    "    mean_rate=('posted_rate', 'mean'),\n",
    "    mean_rpm=('rpm', 'mean'),\n",
    "    mean_mi=('market_index', 'mean'),\n",
    "    mean_qs=('quote_signal', 'mean'),\n",
    "    n=('posted_rate', 'size')\n",
    ").reset_index()\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 8))\n",
    "axes[0, 0].plot(daily['date'], daily['mean_rate'])\n",
    "axes[0, 0].set_title('Daily Mean Rate')\n",
    "axes[0, 1].plot(daily['date'], daily['mean_rpm'])\n",
    "axes[0, 1].set_title('Daily Mean Rate/Mile')\n",
    "axes[1, 0].plot(daily['date'], daily['mean_mi'])\n",
    "axes[1, 0].set_title('Daily Mean Market Index')\n",
    "axes[1, 1].plot(daily['date'], daily['mean_qs'])\n",
    "axes[1, 1].set_title('Daily Mean Quote Signal')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Monthly seasonality\n",
    "train['month'] = train['date'].dt.month\n",
    "monthly = train.groupby('month').agg(\n",
    "    mean_rate=('posted_rate', 'mean'),\n",
    "    mean_rpm=('rpm', 'mean'),\n",
    "    n=('posted_rate', 'size')\n",
    ")\n",
    "print(monthly)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
    "monthly['mean_rate'].plot(kind='bar', ax=axes[0])\n",
    "axes[0].set_title('Mean Rate by Month')\n",
    "monthly['mean_rpm'].plot(kind='bar', ax=axes[1])\n",
    "axes[1].set_title('Mean RPM by Month')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Equipment effects\n",
    "print(train.groupby('equipment')['posted_rate'].describe())\n",
    "print()\n",
    "print(train.groupby('equipment')['rpm'].describe())\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n",
    "train.boxplot(column='posted_rate', by='equipment', ax=axes[0])\n",
    "axes[0].set_title('Rate by Equipment')\n",
    "train.boxplot(column='rpm', by='equipment', ax=axes[1])\n",
    "axes[1].set_title('RPM by Equipment')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Distance vs Rate relationship\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "for i, equip in enumerate(['Dry Van', 'Reefer', 'Flatbed']):\n",
    "    sub = train[train['equipment'] == equip]\n",
    "    axes[i].scatter(sub['distance'], sub['posted_rate'], alpha=0.3, s=5)\n",
    "    axes[i].set_xlabel('Distance')\n",
    "    axes[i].set_ylabel('Rate')\n",
    "    axes[i].set_title(f'{equip}')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Market Index and Quote Signal\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 8))\n",
    "axes[0, 0].scatter(train['market_index'], train['rpm'], alpha=0.1, s=2)\n",
    "axes[0, 0].set_xlabel('Market Index')\n",
    "axes[0, 0].set_ylabel('RPM')\n",
    "axes[0, 0].set_title('RPM vs Market Index (row level)')\n",
    "\n",
    "axes[0, 1].scatter(train['quote_signal'], train['rpm'], alpha=0.1, s=2)\n",
    "axes[0, 1].set_xlabel('Quote Signal')\n",
    "axes[0, 1].set_ylabel('RPM')\n",
    "axes[0, 1].set_title('RPM vs Quote Signal (row level)')\n",
    "\n",
    "axes[1, 0].scatter(daily['mean_mi'], daily['mean_rpm'], alpha=0.7, s=30)\n",
    "axes[1, 0].set_xlabel('Daily Mean Market Index')\n",
    "axes[1, 0].set_ylabel('Daily Mean RPM')\n",
    "axes[1, 0].set_title('Daily Mean RPM vs Daily Mean MI')\n",
    "\n",
    "axes[1, 1].scatter(daily['mean_qs'], daily['mean_rpm'], alpha=0.7, s=30)\n",
    "axes[1, 1].set_xlabel('Daily Mean Quote Signal')\n",
    "axes[1, 1].set_ylabel('Daily Mean RPM')\n",
    "axes[1, 1].set_title('Daily Mean RPM vs Daily Mean QS')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Lane analysis\n",
    "train['lane'] = train['pickup'] + '>' + train['delivery']\n",
    "val['lane'] = val['pickup'] + '>' + val['delivery']\n",
    "\n",
    "lane_stats = train.groupby('lane').agg(\n",
    "    n=('posted_rate', 'size'),\n",
    "    mean_rpm=('rpm', 'mean'),\n",
    "    std_rpm=('rpm', 'std')\n",
    ").reset_index()\n",
    "lane_stats['cv'] = lane_stats['std_rpm'] / lane_stats['mean_rpm']\n",
    "\n",
    "print(f\"Total lanes in train: {lane_stats['lane'].nunique()}\")\n",
    "print(f\"Lanes with >=20 obs: {(lane_stats['n'] >= 20).sum()}\")\n",
    "print(f\"Median lane RPM CV (n>=20): {lane_stats[lane_stats['n'] >= 20]['cv'].median():.4f}\")\n",
    "\n",
    "# Lane overlap\n",
    "train_lanes = set(train['lane'].unique())\n",
    "val_lanes = set(val['lane'].unique())\n",
    "print(f\"\\nVal lanes: {len(val_lanes)}\")\n",
    print(f\"Shared lanes: {len(train_lanes & val_lanes)}\")\n",
    "print(f\"Val rows on seen lane: {val['lane'].isin(train_lanes & val_lanes).mean():.2%}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Missing values\n",
    "print(\"Train missing:\")\n",
    "print(train.isnull().sum()[train.isnull().sum() > 0])\n",
    "print(\"\\nVal missing:\")\n",
    "print(val.isnull().sum()[val.isnull().sum() > 0])\n",
    "\n",
    "# Target by missingness\n",
    "for col in ['weight', 'market_index']:\n",
    "    if col in train.columns:\n",
    "        missing_mean = train[train[col].isna()]['posted_rate'].mean()\n",
    "        not_missing_mean = train[train[col].notna()]['posted_rate'].mean()\n",
    "        print(f\"{col}: missing={missing_mean:.1f}, not_missing={not_missing_mean:.1f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Validation set characteristics\n",
    "print(\"Val date range:\", val['date'].min(), \"to\", val['date'].max())\n",
    "print(\"Val months:\")\n",
    "print(val['date'].dt.to_period('M').value_counts().sort_index())\n",
    "print(\"\\nVal equipment:\")\n",
    "print(val['equipment'].value_counts(normalize=True))\n",
    "print(\"\\nTrain equipment:\")\n",
    "print(train['equipment'].value_counts(normalize=True))\n",
    "\n",
    "# New cities in validation\n",
    "train_cities = set(train['pickup']) | set(train['delivery'])\n",
    "val_cities = set(val['pickup']) | set(val['delivery'])\n",
    "print(f\"\\nNew cities in val: {sorted(val_cities - train_cities)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# December chart\n",
    "print(dec)\n",
    "\n",
    "# Historical Lexington > Fort Wayne in train\n",
    "lex_fw = train[(train['pickup'] == 'Lexington') & (train['delivery'] == 'Fort Wayne')]\n",
    "print(f\"\\nLexington > Fort Wayne in train: {len(lex_fw)} rows\")\n",
    "print(lex_fw[['date', 'distance', 'equipment', 'weight', 'market_index', 'quote_signal', 'posted_rate', 'rpm']].to_string())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Correlation matrix\n",
    "num_cols = train.select_dtypes(include=[np.number]).columns\n",
    "corr = train[num_cols].corr()['posted_rate'].sort_values(ascending=False)\n",
    "print(corr)\n",
    "\n",
    "plt.figure(figsize=(12, 10))\n",
    "sns.heatmap(train[num_cols].corr(), annot=True, fmt='.2f', cmap='RdBu_r', center=0)\n",
    "plt.title('Correlation Matrix')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Key Findings\n",
    "\n",
    "1. **Distance is the dominant signal** (corr ~0.91 with rate). Rate ≈ distance × equipment-specific RPM + intercept.\n",
    "2. **Market Index is a day-level feature** - nearly constant within each day, strong daily-level correlation with RPM (R² ≈ 0.59 with trend).\n",
    "3. **Quote Signal is weak at row level** but shows U-shaped pattern by quintile.\n",
    "4. **Strong monthly seasonality** in RPM: 2.10 (Jan) → 2.33 (Jun) → 2.24 (Oct). No Nov/Dec history.\n",
    "5. **Equipment matters**: Reefer > Flatbed > Dry Van in RPM.\n",
    "6. **Validation is strictly future** (Nov-Dec 2025). Time-based CV required.\n",
    "7. **Distribution shift**: Val market_index mean 0.93 vs train 1.08 (~14% drop).\n",
    "8. **Cold start**: 8 new cities, 12% unseen lanes in validation.\n",
    "9. **December chart**: Fixed lane Lexington→Fort Wayne, only date varies. Need to capture DOW pattern and Dec market level.\n",
    "10. **Target has heavy tail** - MAPE-appropriate, log-transform helps."
   ]
  }
 ],
